# VALO.KR production environment
PORT=3000
NODE_ENV=production
APP_BASE_URL=https://valo.kr

# Riot Developer Portal
RIOT_API_KEY=
RIOT_REGION_HOST=asia.api.riotgames.com

# Riot Sign On - supplied after Production approval
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_REDIRECT_URI=https://valo.kr/auth/callback

# Session / cookie security
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=7

# SQLite database
DB_PATH=./data/valo.db

# API/cache
CACHE_TTL_SECONDS=60
MATCH_LIMIT=20

ENABLE_DEV_MODE=true
